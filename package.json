{
  "name": "finance-dash",
  "version": "1.0.0",
  "private": true,
  "description": "Personal investments dashboard powered by the Pluggy API",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts --dev",
    "build": "vite build",
    "prestart": "yarn build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
