# Get these from https://dashboard.pluggy.ai → your application → "Client ID" / "Client Secret"
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Show Pluggy's test banks (e.g. "Pluggy Bank", user-ok / password-ok) in the connect widget.
PLUGGY_INCLUDE_SANDBOX=true

# Optional: comma-separated item IDs you already created elsewhere (e.g. in the Pluggy dashboard demo).
PLUGGY_ITEM_IDS=

PORT=3000
